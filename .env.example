# 优先使用 Vercel AI Gateway。设置后，/api/classify 会通过 AI SDK 的
# experimental_evaluate 调用模型 typesafe-ai/jev。
AI_GATEWAY_API_KEY=

# 可选。默认 typesafe-ai/jev
# AI_GATEWAY_MODEL=typesafe-ai/jev

# 没有 AI_GATEWAY_API_KEY 时，改走 TypeSafe 直连。
# 密钥在 https://console.typesafe.ai 的 Settings → Keys 创建。
TYPESAFE_API_KEY=

# 可选。默认 jev-latest；直连地址默认 https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
